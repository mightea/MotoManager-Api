DATABASE_URL=sqlite:./db.sqlite
PORT=3001
RP_ID=localhost
RP_NAME=MotoManager
ORIGIN=http://localhost:5173
ENABLE_REGISTRATION=false
RUST_LOG=info
DATA_DIR=./data
CACHE_DIR=./cache
# Local LLM (OpenAI-compatible, e.g. vLLM) for PDF invoice parsing.
# Only ever called from this server — never exposed to clients. Leave
# LLM_BASE_URL unset to disable; the deterministic layout parser still works.
LLM_BASE_URL=http://10.0.0.2:8542/v1
LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct-AWQ
LLM_API_KEY=local-vllm
# Automatic database + uploaded-file backups (VACUUM INTO snapshot + tar.gz of
# images/ and documents/), written to DATA_DIR/backups. Admins can also trigger
# and download backups from the webapp. BACKUP_ENABLED gates only the scheduler.
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
